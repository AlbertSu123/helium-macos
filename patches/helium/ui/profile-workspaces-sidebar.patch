+bool ToolbarView::UsesSidebarLayout() const {
+  const auto* controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  const auto* layout = HeliumLayoutStateController::From(browser_);
+  return display_mode_ == DisplayMode::kNormal && location_bar_view_ &&
