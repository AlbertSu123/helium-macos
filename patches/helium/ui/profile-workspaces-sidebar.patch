+bool VerticalTabStripRegionView::OnMouseWheel(
+    const ui::MouseWheelEvent& event) {
+  if (workspace_switcher_ &&
+      std::abs(event.x_offset()) > std::abs(event.y_offset())) {
+    return workspace_switcher_->HandleWorkspaceScroll(event.x_offset(),
+                                                      event.time_stamp());
+  }
+  return BaseTabStripRegionView::OnMouseWheel(event);
+}
