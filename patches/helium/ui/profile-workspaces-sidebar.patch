+void VerticalTabStripRegionView::OnScrollEvent(ui::ScrollEvent* event) {
+  // Ordinary vertical scrolling continues to scroll tabs. A horizontal swipe
+  // on the sidebar changes the profile-backed workspace instead.
+  if (workspace_switcher_ && event->type() == ui::EventType::kScroll &&
+      std::abs(event->x_offset()) > std::abs(event->y_offset()) &&
+      workspace_switcher_->HandleWorkspaceScroll(event->x_offset(),
+                                                 event->time_stamp())) {
+    event->SetHandled();
+  }
+}
