+
+std::optional<views::ProposedLayout> ToolbarView::CalculateSidebarLayout(
+    const views::SizeBounds& bounds) const {
+  if (!UsesSidebarLayout()) {
+    return std::nullopt;
+  }
+  views::ProposedLayout layout;
+  layout.host_size = gfx::Size(bounds.width().value_or(240), 88);
+  for (const auto& child : children()) {
+    layout.child_layouts.push_back(
+        {.child_view = child.get(), .visible = false, .bounds = gfx::Rect()});
+  }
+  const auto place = [&](views::View* child, const gfx::Rect& rect) {
+    if (child) {
+      auto* child_layout = layout.GetLayoutFor(child);
+      if (child_layout) {
+        child_layout->visible = true;
+        child_layout->bounds = rect;
+      }
+    }
+  };
+  // Native window buttons occupy the first 80px on macOS. Keep navigation on
+  // the same compact row, with a full-width address field beneath it.
+  const int end = layout.host_size.width() - 4;
+  place(vertical_tabs_collapse_button_, gfx::Rect(end - 140, 6, 28, 28));
+  place(back_, gfx::Rect(end - 112, 6, 28, 28));
+  place(forward_, gfx::Rect(end - 84, 6, 28, 28));
+  place(reload_, gfx::Rect(end - 56, 6, 28, 28));
+  place(app_menu_button_, gfx::Rect(end - 28, 6, 28, 28));
+  place(location_bar_view_,
+        gfx::Rect(8, 44, std::max(0, layout.host_size.width() - 16), 36));
+  return layout;
+}
