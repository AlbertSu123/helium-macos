+}
+
+void WorkspaceSwitcherView::Rebuild() {
+  workspaces_.clear();
+  RemoveAllChildViews();
+  for (const auto* entry :
+       storage_->GetAllProfilesAttributesSortedForDisplay()) {
+    if (entry->IsOmitted() || entry->IsSigninRequired()) {
+      continue;
+    }
+    const auto path = entry->GetPath();
+    const auto name = entry->GetName();
+    workspaces_.push_back({path, name});
+  }
+  const auto current = std::ranges::find(
+      workspaces_, browser_->GetProfile()->GetPath(), &Workspace::path);
+  const size_t current_index =
+      current == workspaces_.end() ? 0 : current - workspaces_.begin();
+  const size_t count = std::min(visible_capacity_, workspaces_.size());
+  const size_t first =
+      std::min(current_index > count / 2 ? current_index - count / 2 : 0,
+               workspaces_.size() - count);
+  for (size_t i = first; i < first + count; ++i) {
+    const auto& [path, name] = workspaces_[i];
+    const bool selected = path == browser_->GetProfile()->GetPath();
+    std::u16string symbol = u"•";
+    base::i18n::BreakIterator characters(
+        name, base::i18n::BreakIterator::BREAK_CHARACTER);
+    if (characters.Init() && characters.Advance()) {
+      symbol = characters.GetString();
+    }
+    auto* button = AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceSwitcherView::SwitchWorkspace,
+                            weak_factory_.GetWeakPtr(), path),
+        symbol));
+    button->SetMinSize(gfx::Size(28, 28));
+    button->SetMaxSize(gfx::Size(32, 32));
+    button->SetTooltipText(name);
+    button->GetViewAccessibility().SetName(name);
+    button->GetViewAccessibility().SetIsSelected(selected);
+    button->SetEnabledTextColors(kColorToolbarText);
+    if (selected) {
+      button->SetBackground(
+          views::CreateRoundedRectBackground(kColorLocationBarBackground, 9));
+      if (name_changed_callback_) {
+        name_changed_callback_.Run(name);
+      }
+    }
+  }
+  auto* add = AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&WorkspaceSwitcherView::ShowNameDialog,
+                          weak_factory_.GetWeakPtr(), true),
+      u"+"));
+  add->SetMinSize(gfx::Size(28, 28));
+  add->SetMaxSize(gfx::Size(32, 32));
+  add->SetTooltipText(u"New workspace with a separate profile");
+  add->SetEnabledTextColors(kColorToolbarText);
+  add->SetEnabled(!switching_);
+  InvalidateLayout();
+}
+
+void WorkspaceSwitcherView::SwitchWorkspace(const base::FilePath& path) {
+  if (switching_ || path == browser_->GetProfile()->GetPath()) {
+    return;
+  }
+  auto* entry = storage_->GetProfileAttributesWithPath(path);
+  if (!entry || entry->IsOmitted() || entry->IsSigninRequired()) {
+    return;
+  }
+  switching_ = true;
+  profiles::SwitchToProfile(
+      path, false,
+      base::BindOnce(&WorkspaceSwitcherView::OnWorkspaceReady,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSwitcherView::OnWorkspaceReady(BrowserWindowInterface* target) {
+  switching_ = false;
+  if (!target || target->IsDeleteScheduled() || browser_->IsDeleteScheduled()) {
+    GetViewAccessibility().AnnounceText(u"Could not open that workspace.");
+    Rebuild();
+    return;
+  }
+  SessionStartupPref::SetStartupPref(
+      browser_->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  SessionStartupPref::SetStartupPref(
+      target->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  WorkspaceWindows::Get().Switch(browser_, target);
+}
+
+bool WorkspaceSwitcherView::HandleWorkspaceScroll(float delta,
+                                                  base::TimeTicks timestamp) {
+  if (switching_ || workspaces_.size() < 2) {
+    return false;
+  }
+  const int direction =
+      ScrollTracker().Consume(delta, timestamp.since_origin().InMilliseconds());
+  if (direction == 0) {
+    return true;
+  }
+  const auto current = std::ranges::find(
+      workspaces_, browser_->GetProfile()->GetPath(), &Workspace::path);
+  if (current == workspaces_.end()) {
+    return false;
+  }
+  const int count = static_cast<int>(workspaces_.size());
+  const int index = static_cast<int>(current - workspaces_.begin());
+  SwitchWorkspace(workspaces_[(index + direction + count) % count].path);
+  return true;
+}
+
+bool WorkspaceSwitcherView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  return HandleWorkspaceScroll(
+      event.x_offset() != 0 ? event.x_offset() : event.y_offset(),
+      event.time_stamp());
+}
+
+void WorkspaceSwitcherView::OnScrollEvent(ui::ScrollEvent* event) {
+  if (event->type() == ui::EventType::kScroll &&
+      HandleWorkspaceScroll(
+          std::abs(event->x_offset()) > std::abs(event->y_offset())
+              ? event->x_offset()
+              : event->y_offset(),
+          event->time_stamp())) {
+    event->SetHandled();
+  }
+}
+
+void WorkspaceSwitcherView::RenameWorkspace() {
+  ShowNameDialog(false);
+}
+
+void WorkspaceSwitcherView::ShowNameDialog(bool create) {
+  if (switching_ || !GetWidget()) {
+    return;
+  }
+  if (dialog_widget_) {
+    dialog_widget_->Activate();
+    return;
+  }
+  dialog_delegate_ = std::make_unique<views::DialogDelegate>();
+  auto* dialog = dialog_delegate_.get();
+  dialog->SetTitle(create ? u"New workspace" : u"Rename workspace");
+  dialog->SetButtonLabel(ui::mojom::DialogButton::kOk,
+                         create ? u"Create workspace" : u"Save");
+  dialog->SetModalType(ui::mojom::ModalType::kWindow);
+  auto contents = std::make_unique<views::View>();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(20), 12));
+  auto* input = contents->AddChildView(std::make_unique<views::Textfield>());
+  input->GetViewAccessibility().SetName(u"Workspace name");
+  input->SetPlaceholderText(u"Work, Personal, Research…");
+  input->SetPreferredSize(gfx::Size(300, 36));
+  if (!create) {
+    if (auto* entry = storage_->GetProfileAttributesWithPath(
+            browser_->GetProfile()->GetPath())) {
+      input->SetText(entry->GetName());
+    }
+  }
+  dialog->SetInitiallyFocusedView(input);
+  dialog->SetAcceptCallbackWithClose(base::BindRepeating(
+      [](base::WeakPtr<WorkspaceSwitcherView> view, views::Textfield* input,
+         bool create) {
+        std::u16string name;
+        base::TrimWhitespace(input->GetText(), base::TRIM_ALL, &name);
+        if (!view || name.empty()) {
+          return false;
+        }
+        view->SaveName(create, name);
+        return true;
+      },
+      weak_factory_.GetWeakPtr(), input, create));
+  dialog->SetContentsView(std::move(contents));
+  dialog_widget_ = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  params.SetParent(GetWidget());
+  params.delegate = dialog;
+  dialog_widget_->Init(std::move(params));
+  dialog_widget_->MakeCloseSynchronous(base::BindOnce(
+      [](base::WeakPtr<WorkspaceSwitcherView> view,
+         views::Widget::ClosedReason) {
+        if (view) {
+          view->dialog_widget_.reset();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  dialog_widget_->Show();
+}
+
+void WorkspaceSwitcherView::SaveName(bool create, const std::u16string& name) {
+  if (!create) {
+    if (auto* entry = storage_->GetProfileAttributesWithPath(
+            browser_->GetProfile()->GetPath())) {
+      entry->SetLocalProfileName(name, false);
+    }
+    return;
+  }
+  switching_ = true;
+  Rebuild();
+  ProfileManager::CreateMultiProfileAsync(
+      name, storage_->ChooseAvatarIconIndexForNewProfile(), false,
+      base::BindOnce(&WorkspaceSwitcherView::OnProfileCreated,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSwitcherView::OnProfileCreated(Profile* profile) {
+  switching_ = false;
+  Rebuild();
+  if (!profile) {
+    GetViewAccessibility().AnnounceText(u"Could not create the workspace.");
+    return;
+  }
+  SwitchWorkspace(profile->GetPath());
+}
+
+void WorkspaceSwitcherView::OnThemeChanged() {
+  views::FlexLayoutView::OnThemeChanged();
+}
+
+void WorkspaceSwitcherView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::FlexLayoutView::OnBoundsChanged(previous_bounds);
+  const size_t capacity =
+      static_cast<size_t>(std::clamp((width() - 52) / 36, 1, 5));
+  if (capacity != visible_capacity_) {
+    visible_capacity_ = capacity;
+    Rebuild();
+  }
+}
