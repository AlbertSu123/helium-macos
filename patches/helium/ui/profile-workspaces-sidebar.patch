+// Park only windows switched by the workspace control, leaving unrelated
+// windows alone. Closing the visible workspace reveals a parked one, while
+// Quit still follows Chrome's normal shutdown path for every profile.
+class WorkspaceWindows : public BrowserCollectionObserver {
+ public:
+  static WorkspaceWindows& Get() {
+    static base::NoDestructor<WorkspaceWindows> instance;
+    return *instance;
+  }
+
+  WorkspaceWindows() {
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+  }
+
+  void Switch(BrowserWindowInterface* source, BrowserWindowInterface* target) {
+    if (!target || target == source || source->IsDeleteScheduled() ||
+        target->IsDeleteScheduled() || browser_shutdown::IsTryingToQuit()) {
+      return;
+    }
+    std::erase(parked_, target);
+    auto* old_window = source->GetWindow();
+    auto* new_window = target->GetWindow();
+    if (!old_window->IsFullscreen() && !new_window->IsFullscreen()) {
+      new_window->SetBounds(old_window->GetBounds());
+    }
+    if (std::ranges::find(parked_, source) == parked_.end()) {
+      parked_.push_back(source);
+    }
+    active_ = target;
+    new_window->Show();
+    new_window->Activate();
+    old_window->Hide();
+  }
+
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    std::erase(parked_, browser);
+    if (active_ != browser) {
+      return;
+    }
+    active_ = nullptr;
+    if (browser_shutdown::IsTryingToQuit() || parked_.empty()) {
+      return;
+    }
+    auto* previous = parked_.back().get();
+    parked_.pop_back();
+    active_ = previous;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<BrowserWindowInterface> window) {
+                         if (window && !browser_shutdown::IsTryingToQuit()) {
+                           window->GetWindow()->Show();
+                           window->GetWindow()->Activate();
+                         }
+                       },
+                       previous->GetWeakPtr()));
+  }
+
+ private:
+  std::vector<raw_ptr<BrowserWindowInterface>> parked_;
+  raw_ptr<BrowserWindowInterface> active_ = nullptr;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
+
+WorkspaceScrollTracker& ScrollTracker() {
+  static WorkspaceScrollTracker tracker;
+  return tracker;
+}
