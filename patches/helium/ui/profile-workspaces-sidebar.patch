+void WorkspaceSwitcherView::OnProfileAdded(const base::FilePath&) {
+  Rebuild();
+}
+
+void WorkspaceSwitcherView::OnProfileWasRemoved(const base::FilePath&,
+                                                const std::u16string&) {
+  Rebuild();
+}
+
+void WorkspaceSwitcherView::OnProfileNameChanged(const base::FilePath&,
+                                                 const std::u16string&) {
+  Rebuild();
+}
+
+void WorkspaceSwitcherView::OnProfileIsOmittedChanged(const base::FilePath&) {
+  Rebuild();
+}
+
+void WorkspaceSwitcherView::OnProfileSigninRequiredChanged(
+    const base::FilePath&) {
+  Rebuild();
+}
