+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_SCROLL_TRACKER_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_SCROLL_TRACKER_H_
+
+#include <cmath>
+#include <cstdint>
+
+// Shared between profile windows so the tail of one gesture cannot switch the
+// newly activated workspace again. A quiet interval starts a fresh gesture.
+class WorkspaceScrollTracker {
+ public:
+  int Consume(float delta, int64_t time_ms) {
+    if (!std::isfinite(delta) || delta == 0) {
+      return 0;
+    }
+    if (last_event_ms_ < 0 || time_ms - last_event_ms_ > 180 ||
+        time_ms < last_event_ms_) {
+      accumulated_ = 0;
+      gesture_switched_ = false;
+    }
+    last_event_ms_ = time_ms;
+    if (gesture_switched_ ||
+        (last_switch_ms_ >= 0 && time_ms - last_switch_ms_ < 450)) {
+      return 0;
+    }
+    if (accumulated_ * delta < 0) {
+      accumulated_ = 0;
+    }
+    accumulated_ += delta;
+    if (std::abs(accumulated_) < 48) {
+      return 0;
+    }
+    const int direction = accumulated_ > 0 ? -1 : 1;
+    accumulated_ = 0;
+    last_switch_ms_ = time_ms;
+    gesture_switched_ = true;
+    return direction;
+  }
+
+ private:
+  float accumulated_ = 0;
+  int64_t last_event_ms_ = -1;
+  int64_t last_switch_ms_ = -1;
+  bool gesture_switched_ = false;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_WORKSPACE_SCROLL_TRACKER_H_
